% =============================================================================
%  VI.  Evaluation
% =============================================================================
\section{Evaluation}\label{sec:eval}

\subsection{Experimental Setting}\label{sec:eval:setup}

\subsubsection{Dataset}  We use the same $227{,}894$ IPv6 BGP
routing prefixes from
RouteViews~\cite{routeviews} used
by~\cite{wei2025gungnir}, and take Luori's public
FRP set~\cite{cheng2024luori} as the initial seed set
$\mathcal{S}_0$ ($182{,}942$ ICMPv6 FRPs over $4{,}643$
routing prefixes).

\subsubsection{Hyper-parameters}
DS-HMamba uses 6 layers, hidden dim $d=128$, state dim $N=16$
and Conv-1D width 4.  Pre-training runs for 50 epochs with
Adam ($\text{lr}=10^{-3}$, batch 512).  Online fine-tuning is
mini-batched at size 16 with 1 gradient step per snapshot to
avoid the OOM issue we experienced early in development.
APD uses $16$ probe addresses/prefix (one per nibble), max
$5$ attempts, timeout $2\,\text{s}$.

\subsubsection{Baselines}
\emph{Luori}~\cite{cheng2024luori} (MCTS-RL) and
\emph{Gungnir}~\cite{wei2025gungnir} (Transformer AR), both run
with authors' released code and identical hyper-parameters
except probing budget.

\subsubsection{Probing Budget Grid}
Following Gungnir's setup we sweep the total probe budget
$B_{\text{total}}\!\in\!\{2\text{M},4\text{M},6\text{M},
8\text{M},10\text{M}\}$ packets.  All methods observe the
same grid.

\subsubsection{Metrics}
$|\mathcal{F}|$ (confirmed FRPs),
\textsc{CovSpace} (covered address space,
$\sum_{f\in\mathcal{F}}2^{128-\ell(f)}$),
\textsc{CovAS} (unique origin ASes),
\textsc{CovRouting} (unique BGP prefixes),
\textsc{CovCountry}, \textsc{CovCat}.

\subsection{Overall Performance}\label{sec:eval:perf}

Table~\ref{tab:main} reports the \emph{raw} performance grid;
Table~\ref{tab:main_netnew} reports the same experiment
restricted to FRPs that are \emph{not} covered by the aligned
seed set $\mathcal{S}_{0}$ --- i.e., discoveries that materially
enlarge the known FRP universe.  Fig.~\ref{fig:panels}
visualises the raw view and Fig.~\ref{fig:panels_netnew} the
net-new view.  Key findings:
\begin{itemize}
   \item \textbf{FRP count (raw).}  6FRP dominates uniformly, with
   a $2.8\!-\!6.5\times$ advantage over Gungnir and a
   $1.3\!-\!1.4\times$ advantage over Luori
   (Fig.~\ref{fig:panels}\,a; Table~\ref{tab:main}, row~$|\mathcal{F}|$).
   \item \textbf{FRP count (net-new).}  The picture becomes more
   dramatic once seed overlap is removed
   (Fig.~\ref{fig:panels_netnew}\,a).  Gungnir plateaus below
   $10^{3}$ across all budgets ($201\!\to\!954$), Luori saturates
   at $\sim\!2{,}300$ once its MCTS exhausts the seed set, and
   only 6FRP shows super-linear growth
   ($165\!\to\!3{,}084$, $\times 18.7$ from $2$M to $10$M
   vs.\ $\times 4.7$ for Gungnir and $\times 2.0$ for Luori;
   Table~\ref{tab:main_netnew}).  At the $10$M budget 6FRP
   contributes $3{,}084$ genuinely new FRPs, i.e.\ $3.23\times$
   more than Gungnir and $1.35\times$ more than Luori.
   \item \textbf{Covered address space.}  On the log scale of
   Fig.~\ref{fig:panels}\,b, 6FRP sits $1$--$2$ orders of
   magnitude above both baselines.  At $10\text{M}$,
   6FRP covers $2.04\!\times\!10^{32}$ addresses vs.\
   $3.46\!\times\!10^{31}$ for Gungnir---a $5.9\times$ raw gain.
   In net-new terms the gap widens further to $\times 20$
   ($7.5\!\times\!10^{31}$ vs.\ $3.7\!\times\!10^{30}$;
   Table~\ref{tab:main_netnew}, row \textsc{CovSpace}).
   \item \textbf{Topological breadth.}  6FRP touches
   $314$ ASes and $44$ countries at $10\text{M}$ (raw), vs.\
   Gungnir's $97$/$25$ and Luori's $7$/$2$
   (Fig.~\ref{fig:panels}\,d,e).  Among net-new discoveries the
   advantage is $230$/$41$ ASes/countries vs.\ Gungnir's
   $49$/$19$ and Luori's $4$/$2$.
   \item \textbf{Redundancy trajectory.}  The parenthesised row
   of Table~\ref{tab:main_netnew} tracks the in-range fraction
   of $|\mathcal{F}|$.  6FRP is very redundant early
   ($93\%$ at $2$M, because the model still mimics the seed
   distribution) but becomes progressively less redundant as
   the in-range-aware feedback loop kicks in ($35\%$ at $10$M).
   Gungnir stays at $\sim\!43\%$ and Luori at $\sim\!30\%$
   throughout, reflecting the absence of a feedback mechanism.
\end{itemize}

